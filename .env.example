# Public Supabase project settings. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only credentials. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
OPENAI_API_KEY=replace-with-server-only-key
DEMO_USER_PASSWORD=replace-with-a-local-demo-password-at-least-12-chars

# Application settings.
OPENAI_MODEL=gpt-5.6-luna
# Local by default; use https://crmleads.carlosrevert.es in the deployed environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: only needed when applying migrations with psql instead of Supabase SQL Editor.
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
